---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import AfrahAppPortal from '../../components/afrah-app/AfrahAppPortal';

export function getStaticPaths() {
  const paths = [
    'clients',
    'vendor',
    'banks',
    'construction-labour',
    'interior',
    'interior/directory',
    'interior/vendor',
    'interior/labour-contract',
    'bricks',
    'bricks/directory',
    'bricks/expenses',
    'bricks/stock',
  ];
  return paths.map((path) => ({ params: { path } }));
}
---

<Layout 
  title="Afrah Constructions | Operations, Procurement & Banking ERP"
  description="Manage enterprise client accounts, milestone billing schedules, vendor procurement ledgers, and multi-bank corporate finances for Afrah Constructions."
>
  <AfrahAppPortal client:only="react" />
</Layout>
