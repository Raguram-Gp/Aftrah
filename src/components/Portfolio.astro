---
// Section 02 / Portfolio — Theni district residences
const projects = [
  {
    id: 'teak-courtyard',
    category: 'villas',
    name: 'Teak Courtyard Villa',
    type: 'Independent Residence / Uthamapalayam',
    gia: 'THENI DT.',
    year: 'TURNKEY HOME',
    image: '/images/homes/villa-teak.jpg',
    alt: 'Contemporary teak and glass villa in Uthamapalayam, Theni',
    offset: false,
  },
  {
    id: 'horizon-villa',
    category: 'villas',
    name: 'Horizon Villa',
    type: 'Two-Storey Residence / Theni',
    gia: 'THENI DT.',
    year: 'TURNKEY HOME',
    image: '/images/homes/villa-horizon.jpg',
    alt: 'Modern two-storey villa with car porch in Theni',
    offset: true,
  },
  {
    id: 'jaali-twins',
    category: 'duplex',
    name: 'Jaali Twin Homes',
    type: 'Duplex Residence / Chinnamanur',
    gia: 'CHINNAMANUR',
    year: 'TURNKEY HOME',
    image: '/images/homes/duplex-jaali.jpg',
    alt: 'Twin duplex homes with teak jaali screens in Chinnamanur',
    offset: false,
  },
  {
    id: 'lattice-garden',
    category: 'villas',
    name: 'Lattice Garden House',
    type: 'Compound Residence / Cumbum',
    gia: 'CUMBUM',
    year: 'TURNKEY HOME',
    image: '/images/homes/villa-lattice.jpg',
    alt: 'Garden compound house with terracotta lattice wall in Cumbum',
    offset: true,
  },
  {
    id: 'leaf-screen',
    category: 'villas',
    name: 'Leaf Screen Villa',
    type: 'Independent Residence / Uthamapalayam',
    gia: 'UTHAMPALAYAM',
    year: 'TURNKEY HOME',
    image: '/images/homes/villa-leaf.jpg',
    alt: 'Villa with leaf jaali screen and teak pergola in Uthamapalayam',
    offset: false,
  },
  {
    id: 'green-court',
    category: 'duplex',
    name: 'Green Court Duplex',
    type: 'Duplex with Car Porch / Theni',
    gia: 'THENI DT.',
    year: 'TURNKEY HOME',
    image: '/images/homes/duplex-green.jpg',
    alt: 'Duplex home with teak ceiling and green elevation in Theni',
    offset: true,
  },
  {
    id: 'line-light',
    category: 'residences',
    name: 'Line Light House',
    type: 'Street Facade / Theni',
    gia: 'THENI DT.',
    year: 'TURNKEY HOME',
    image: '/images/homes/residence-line.jpg',
    alt: 'Contemporary house with diagonal light line elevation in Theni',
    offset: false,
  },
  {
    id: 'dusk-facade',
    category: 'residences',
    name: 'Dusk Facade Residence',
    type: 'Night Elevation / Uthamapalayam',
    gia: 'UTHAMPALAYAM',
    year: 'TURNKEY HOME',
    image: '/images/homes/residence-dusk.jpg',
    alt: 'Night-lit two-storey residence in Uthamapalayam',
    offset: true,
  },
];

const filters = [
  { label: 'All Homes', key: 'all' },
  { label: 'Villas', key: 'villas' },
  { label: 'Duplex Homes', key: 'duplex' },
  { label: 'Residences', key: 'residences' },
];
---

<section class="section-padding" id="portfolio" style="background-color: var(--surface-container-lowest);">
  <!-- Section Header with Filters -->
  <div class="grid-12 portfolio-header">
    <div class="portfolio-label-col">
      <h2 class="font-mono-data" style="color: var(--text-secondary); letter-spacing: 0.15em; text-transform: uppercase;" data-animate="fade-up">
        02 / PORTFOLIO
      </h2>
    </div>
    <div class="portfolio-filters-col">
      {filters.map((filter, i) => (
        <button
          class={`filter-pill font-label-caps ${i === 0 ? 'active' : ''}`}
          data-filter={filter.key}
          data-animate="fade-up"
          style={`--stagger: ${(i + 1) * 80}ms;`}
        >
          {filter.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="grid-12 portfolio-grid" id="portfolio-grid">
    {projects.map((project, i) => (
      <div
        class={`portfolio-card ${project.offset ? 'portfolio-card-offset' : ''}`}
        data-category={project.category}
        data-animate="fade-up"
        style={`--stagger: ${(i % 2 === 0 ? 100 : 250)}ms;`}
      >
        <div class="portfolio-card-image img-zoom">
          <img src={project.image} alt={project.alt} loading="lazy" />
          <div class="portfolio-card-overlay"></div>
        </div>
        <div class="portfolio-card-info">
          <div class="portfolio-card-meta">
            <h3 class="font-headline-md" style="color: var(--primary); margin-bottom: 8px;">{project.name}</h3>
            <p class="font-body-sm" style="color: var(--text-secondary);">{project.type}</p>
          </div>
          <div class="portfolio-card-data">
            <span class="portfolio-gia font-mono-data">{project.gia}</span>
            <span class="font-mono-data" style="color: var(--text-secondary); font-size: 10px;">{project.year}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  function setupPortfolioFilters() {
    const filterPills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.portfolio-card');

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const filter = pill.getAttribute('data-filter');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (card as HTMLElement).style.display = '';
            (card as HTMLElement).style.opacity = '1';
            (card as HTMLElement).style.transform = 'translateY(0)';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPortfolioFilters);
  } else {
    setupPortfolioFilters();
  }
</script>

<style>
  .portfolio-header {
    margin-bottom: 64px;
  }

  .portfolio-label-col {
    grid-column: span 4;
  }

  .portfolio-filters-col {
    grid-column: span 4;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: flex-start;
  }

  @media (min-width: 768px) {
    .portfolio-label-col {
      grid-column: span 3;
    }
    .portfolio-filters-col {
      grid-column: span 9;
      justify-content: flex-end;
    }
  }

  .filter-pill {
    padding: 8px 16px;
    border-radius: 9999px;
    border: 1px solid var(--border-stroke);
    color: var(--text-secondary);
    background: none;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-pill.active {
    border-color: var(--primary);
    background-color: var(--primary);
    color: var(--on-primary);
    box-shadow: 0 4px 16px var(--glow-color);
  }

  .filter-pill:not(.active):hover {
    border-color: var(--primary);
    color: var(--primary);
    background-color: var(--hover-highlight-bg);
  }

  /* Projects Grid */
  .portfolio-grid {
    row-gap: 64px;
  }

  .portfolio-card {
    grid-column: span 4;
    cursor: pointer;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  @media (min-width: 768px) {
    .portfolio-card {
      grid-column: span 6;
    }
    .portfolio-card-offset {
      margin-top: 80px;
    }
  }

  .portfolio-card-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--surface-container);
    margin-bottom: 20px;
    position: relative;
    border-radius: 4px;
    box-shadow: var(--surface-glass-shadow);
  }

  .portfolio-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portfolio-card:hover .portfolio-card-image img {
    transform: scale(1.05);
  }

  .portfolio-card-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--card-overlay-bg);
    transition: background-color 0.5s ease;
  }

  .portfolio-card:hover .portfolio-card-overlay {
    background-color: transparent;
  }

  .portfolio-card-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .portfolio-card-data {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .portfolio-gia {
    color: var(--primary);
    background-color: var(--surface);
    padding: 4px 10px;
    border-radius: 2px;
    border: 1px solid var(--border-stroke);
    font-size: 11px;
    white-space: nowrap;
    transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
  }
</style>
