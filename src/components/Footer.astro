---
// Footer — AFRAH Construction
---

<footer class="footer" style="background-color: var(--surface-container-lowest); border-top: 1px solid var(--border-stroke);">
  <div class="footer-inner">
    <!-- Left Column: Logo & Copyright -->
    <div class="footer-left">
      <img
        alt="AFRAH Construction"
        class="footer-logo"
        src="/logos/afrah-construction.jpg"
      />
      <div class="footer-copyright">
        <p class="font-mono-data" style="color: var(--text-secondary);">
          © 2026 AFRAH CONSTRUCTION. ALL RIGHTS RESERVED.
        </p>
      </div>
    </div>

    <!-- Right Column: Locations -->
    <div class="footer-right">
      <ul class="footer-locations">
        <li>
          <a href="https://maps.google.com/?q=Chinnamanur,+Theni" class="font-mono-data footer-link" target="_blank" rel="noreferrer">Chinnamanur / Theni — 625 515</a>
        </li>
        <li>
          <a href="https://maps.google.com/?q=Uthamapalayam,+Theni" class="font-mono-data footer-link" target="_blank" rel="noreferrer">Uthamapalayam / Theni Dt.</a>
        </li>
      </ul>
      <ul class="footer-certs">
        <li class="font-mono-data" style="color: var(--primary);">THENI DISTRICT</li>
        <li class="font-mono-data" style="color: var(--primary);">TAMIL NADU</li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    padding: 80px var(--margin-mobile);
  }

  @media (min-width: 768px) {
    .footer {
      padding: 80px var(--margin-desktop);
    }
  }

  .footer-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: repeat(12, 1fr);
    }
  }

  .footer-left {
    grid-column: span 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
  }

  @media (min-width: 768px) {
    .footer-left {
      grid-column: span 4;
    }
  }

  .footer-logo {
    width: 96px;
    height: auto;
    border-radius: 4px;
    opacity: 0.95;
    transition: opacity 0.3s ease;
  }

  .footer-copyright {
    margin-top: auto;
    transition: color 0.4s ease;
  }

  .footer-right {
    grid-column: span 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-height: 200px;
  }

  @media (min-width: 768px) {
    .footer-right {
      grid-column: 9 / span 4;
    }
  }

  .footer-locations {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-link {
    color: var(--text-secondary);
    text-decoration: underline;
    transition: color 0.3s ease;
  }

  .footer-link:hover {
    color: var(--primary);
  }

  .footer-certs {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: auto;
  }
</style>
