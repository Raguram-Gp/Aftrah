---
// Section 03 / Site Cinematics & Walkthroughs — Ongoing Construction & Finished Homes
import { INITIAL_REELS } from './afrah-app/data/initialReels';
import type { SiteReel } from './afrah-app/types';

const reels: SiteReel[] = INITIAL_REELS;

const filters = [
  { label: 'All Reels', key: 'all', count: reels.length },
  { label: 'Ongoing Sites', key: 'ongoing', count: reels.filter(r => r.category === 'ongoing').length },
  { label: 'Finished Homes', key: 'finished', count: reels.filter(r => r.category === 'finished').length },
];
---

<section class="section-padding cinematics-section" id="cinematics">
  <!-- Decorative Background Architectural Grid Glow -->
  <div class="cinematics-ambient-glow"></div>

  <!-- Section Header -->
  <div class="grid-12 cinematics-header">
    <div class="cinematics-label-col">
      <div class="cinematics-badge font-mono-data" data-animate="fade-up">
        <span class="pulsing-record-dot"></span>
        <span>LIVE SITES & ARCHIVE</span>
      </div>
      <h2 class="font-mono-data cinematics-section-num" data-animate="fade-up" style="--stagger: 50ms;">
        03 / CRAFTSMANSHIP IN MOTION
      </h2>
    </div>

    <div class="cinematics-title-col">
      <div class="cinematics-headline-wrap">
        <h3 class="font-display-lg cinematics-heading" data-animate="fade-up" style="--stagger: 100ms;">
          Raw On-Site Precision.<br />Finished Landmarks.
        </h3>
        <p class="font-body-lg cinematics-lead" data-animate="fade-up" style="--stagger: 150ms;">
          Watch our engineers pour foundations, assemble bespoke teak elevations, and walk through completed turnkey family residences across Theni district.
        </p>
      </div>

      <!-- Filter Tabs & Carousel Controls -->
      <div class="cinematics-controls-bar" data-animate="fade-up" style="--stagger: 200ms;">
        <!-- Filter Tabs -->
        <div class="reel-filter-tabs">
          {filters.map((filter, i) => (
            <button
              class={`filter-tab-pill font-label-caps ${i === 0 ? 'active' : ''}`}
              data-filter={filter.key}
              aria-label={`Filter by ${filter.label}`}
            >
              <span>{filter.label}</span>
              <span class="tab-count font-mono-data">{filter.count}</span>
            </button>
          ))}
        </div>

        <!-- Carousel Navigation Controls -->
        <div class="carousel-nav-group">
          <div class="carousel-counter font-mono-data">
            <span id="carousel-current">01</span>
            <span class="counter-divider">/</span>
            <span id="carousel-total">{reels.length < 10 ? `0${reels.length}` : reels.length}</span>
          </div>

          <div class="carousel-buttons">
            <button class="carousel-btn prev-btn" id="carousel-prev-btn" aria-label="Previous Video Slide">
              <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <button class="carousel-btn next-btn" id="carousel-next-btn" aria-label="Next Video Slide">
              <span class="material-symbols-outlined">chevron_right</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Carousel Viewport & Track Container -->
  <div class="carousel-viewport">
    <div class="carousel-track" id="cinematics-carousel-track">
      {reels.map((reel, index) => (
        <article
          class="reel-item"
          data-category={reel.category}
          data-reel-id={reel.id}
          data-index={index}
          data-animate="fade-up"
          style={`--stagger: ${(index % 3 + 1) * 100}ms;`}
        >
          <!-- Video Box Container -->
          <div class="reel-video-container" id={`video-box-${reel.id}`}>
            <!-- HTML5 Video Player -->
            <video
              class="reel-video-element"
              id={`video-${reel.id}`}
              poster={reel.poster}
              preload="metadata"
              playsinline
              muted
              loop
            >
              <source src={reel.videoSrc} type={reel.videoSrc.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
              Your browser does not support HTML5 video playback.
            </video>

            <!-- Video Poster & Play Trigger Overlay -->
            <div class="video-poster-overlay" id={`poster-overlay-${reel.id}`}>
              <img
                src={reel.poster}
                alt={`${reel.title} - ${reel.subtitle}`}
                class="poster-fallback-img"
                loading="lazy"
              />
              <div class="poster-gradient-shade"></div>

              <!-- Top Badges in Overlay -->
              <div class="poster-top-bar">
                <span class="stage-tag font-mono-data">{reel.stage}</span>
                <span class={`category-tag font-mono-data ${reel.category}`}>
                  <span class="status-dot"></span>
                  {reel.category === 'ongoing' ? 'ON-SITE' : 'FINISHED'}
                </span>
              </div>

              <!-- Center Glowing Play Button -->
              <button
                class="central-play-trigger"
                id={`play-btn-${reel.id}`}
                aria-label={`Play video: ${reel.title}`}
                data-reel-id={reel.id}
              >
                <div class="play-pulse-ring"></div>
                <div class="play-icon-disc">
                  <span class="material-symbols-outlined play-arrow-icon">play_arrow</span>
                </div>
              </button>

              <!-- Bottom Meta in Overlay -->
              <div class="poster-bottom-meta">
                <span class="duration-chip font-mono-data">
                  <span class="material-symbols-outlined" style="font-size: 13px;">schedule</span>
                  {reel.duration}
                </span>
                <button
                  class="overlay-expand-btn"
                  data-theater-id={reel.id}
                  aria-label="Fullscreen Theater View"
                  title="Fullscreen Theater View"
                >
                  <span class="material-symbols-outlined" style="font-size: 16px;">open_in_full</span>
                </button>
              </div>
            </div>

            <!-- Inline Floating Video Controls Bar (Visible during active inline playback) -->
            <div class="inline-video-controls" id={`controls-${reel.id}`}>
              <div class="controls-left">
                <button
                  class="control-icon-btn inline-play-pause-btn"
                  id={`inline-toggle-${reel.id}`}
                  aria-label="Pause video"
                  data-reel-id={reel.id}
                >
                  <span class="material-symbols-outlined control-symbol">pause</span>
                </button>
                <button
                  class="control-icon-btn inline-mute-btn"
                  id={`inline-mute-${reel.id}`}
                  aria-label="Toggle audio"
                  data-reel-id={reel.id}
                >
                  <span class="material-symbols-outlined control-symbol">volume_off</span>
                </button>
              </div>

              <!-- Video Timeline Scrubber Track -->
              <div class="inline-progress-track">
                <div class="inline-progress-fill" id={`progress-${reel.id}`}></div>
              </div>

              <div class="controls-right">
                <button
                  class="control-icon-btn theater-expand-btn"
                  aria-label="Open in Cinematic Theater Mode"
                  data-theater-id={reel.id}
                  title="Expand to Fullscreen Theater View"
                >
                  <span class="material-symbols-outlined control-symbol">open_in_full</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Bottom Meta Bar (Refined architectural presentation) -->
          <div class="reel-item-info">
            <div class="reel-item-meta">
              <h4 class="font-headline-md reel-title">{reel.title}</h4>
              <p class="font-body-sm reel-subtitle">{reel.subtitle}</p>
            </div>
            <div class="reel-item-data">
              <span class="reel-location-pill font-mono-data">{reel.location}</span>
              <button
                class="reel-theater-btn font-mono-data"
                data-theater-id={reel.id}
                title="View full project specifications"
              >
                <span>SPECS</span>
                <span class="material-symbols-outlined" style="font-size: 13px;">arrow_outward</span>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Bottom Interactive Scroll Progress Indicator -->
  <div class="grid-12" style="margin-top: 32px;">
    <div class="carousel-progress-col">
      <div class="carousel-progress-bar">
        <div class="carousel-progress-thumb" id="carousel-progress-thumb"></div>
      </div>
      <div class="carousel-swipe-hint font-mono-data">
        <span>← DRAG OR SCROLL TO EXPLORE ARCHIVE →</span>
      </div>
    </div>
  </div>

  <!-- CINEMATIC THEATER MODAL -->
  <div class="cinematic-modal-overlay" id="cinematic-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-backdrop" id="modal-backdrop"></div>
    <div class="modal-dialog-container">
      <div class="modal-window glass-panel">
        <!-- Modal Top Bar -->
        <div class="modal-header-bar">
          <div class="modal-header-info">
            <span class="modal-category-chip font-mono-data" id="modal-category-chip">ON-SITE SITE</span>
            <h4 class="font-headline-md modal-title" id="modal-title">Project Title</h4>
            <span class="modal-location font-mono-data" id="modal-location">Location</span>
          </div>

          <button class="modal-close-btn" id="modal-close-btn" aria-label="Close Theater View">
            <span class="material-symbols-outlined" style="font-size: 24px;">close</span>
          </button>
        </div>

        <!-- Modal Video Viewport -->
        <div class="modal-video-box">
          <video
            class="modal-video-element"
            id="modal-video-element"
            playsinline
            preload="auto"
          >
            Your browser does not support HTML5 video.
          </video>

          <!-- Custom Modal Video Overlay Controls -->
          <div class="modal-controls-overlay">
            <div class="modal-progress-bar" id="modal-progress-bar">
              <div class="modal-progress-fill" id="modal-progress-fill"></div>
            </div>

            <div class="modal-controls-bottom">
              <div class="modal-controls-left">
                <button class="modal-ctrl-btn" id="modal-play-btn" aria-label="Play/Pause">
                  <span class="material-symbols-outlined" id="modal-play-icon">play_arrow</span>
                </button>
                <button class="modal-ctrl-btn" id="modal-volume-btn" aria-label="Audio Mute">
                  <span class="material-symbols-outlined" id="modal-volume-icon">volume_up</span>
                </button>
                <span class="modal-time-display font-mono-data" id="modal-time-display">0:00 / 0:00</span>
              </div>

              <div class="modal-controls-right">
                <button class="modal-ctrl-btn" id="modal-fullscreen-btn" aria-label="Toggle Fullscreen">
                  <span class="material-symbols-outlined">fullscreen</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Modal Details Drawer -->
        <div class="modal-details-drawer">
          <div class="modal-desc-wrap">
            <h5 class="modal-stage-headline font-label-caps" id="modal-stage-headline">Stage: Framework</h5>
            <p class="font-body-sm modal-desc-text" id="modal-desc-text">Full narrative description...</p>
          </div>

          <div class="modal-specs-wrap">
            <div class="modal-specs-list" id="modal-specs-list">
              <!-- Dynamically populated -->
            </div>
            <a href="/#inquiry" class="modal-inquire-btn font-label-caps" id="modal-inquire-cta">
              <span>Inquire For Your Project</span>
              <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    getStoredReels,
    resolveMediaUrl,
    subscribeToReelsUpdates,
  } from '@/lib/videoStorage';
  import type { SiteReel } from './afrah-app/types';

  function escapeHtml(str: string): string {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function initSiteCinematics() {
    const track = document.getElementById('cinematics-carousel-track');
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');
    const currentIndicator = document.getElementById('carousel-current');
    const totalIndicator = document.getElementById('carousel-total');
    const progressThumb = document.getElementById('carousel-progress-thumb');
    const filterTabs = document.querySelectorAll('.filter-tab-pill');

    const modal = document.getElementById('cinematic-modal');
    // The page wraps sections in a z-indexed container, which would trap the modal below the fixed navbar.
    if (modal && modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    const modalBackdrop = document.getElementById('modal-backdrop');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalVideo = document.getElementById('modal-video-element') as HTMLVideoElement | null;
    const modalTitle = document.getElementById('modal-title');
    const modalLocation = document.getElementById('modal-location');
    const modalCategoryChip = document.getElementById('modal-category-chip');
    const modalStageHeadline = document.getElementById('modal-stage-headline');
    const modalDescText = document.getElementById('modal-desc-text');
    const modalSpecsList = document.getElementById('modal-specs-list');
    const modalPlayBtn = document.getElementById('modal-play-btn');
    const modalPlayIcon = document.getElementById('modal-play-icon');
    const modalVolumeBtn = document.getElementById('modal-volume-btn');
    const modalVolumeIcon = document.getElementById('modal-volume-icon');
    const modalTimeDisplay = document.getElementById('modal-time-display');
    const modalProgressBar = document.getElementById('modal-progress-bar');
    const modalProgressFill = document.getElementById('modal-progress-fill');
    const modalFullscreenBtn = document.getElementById('modal-fullscreen-btn');
    const modalInquireCta = document.getElementById('modal-inquire-cta');

    let activeFilter = 'all';
    let reelsData: SiteReel[] = [];
    let cards: HTMLElement[] = [];

    function getVisibleCards() {
      return cards.filter(card => card.style.display !== 'none');
    }

    function updateCarouselIndicators() {
      if (!track) return;
      const visible = getVisibleCards();
      if (visible.length === 0) return;

      const trackScroll = track.scrollLeft;
      const cardWidth = (visible[0] as HTMLElement).offsetWidth + 24;
      let activeIndex = Math.round(trackScroll / cardWidth);
      activeIndex = Math.max(0, Math.min(activeIndex, visible.length - 1));

      if (currentIndicator) {
        currentIndicator.textContent = activeIndex + 1 < 10 ? `0${activeIndex + 1}` : `${activeIndex + 1}`;
      }
      if (totalIndicator) {
        totalIndicator.textContent = visible.length < 10 ? `0${visible.length}` : `${visible.length}`;
      }

      if (progressThumb) {
        const maxScroll = track.scrollWidth - track.clientWidth;
        const progress = maxScroll > 0 ? (track.scrollLeft / maxScroll) * 100 : 0;
        progressThumb.style.width = `${Math.max(12, Math.min(100, progress))}%`;
      }

      if (prevBtn) {
        (prevBtn as HTMLButtonElement).disabled = track.scrollLeft <= 10;
        (prevBtn as HTMLElement).style.opacity = track.scrollLeft <= 10 ? '0.4' : '1';
      }
      if (nextBtn) {
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 10;
        (nextBtn as HTMLButtonElement).disabled = atEnd;
        (nextBtn as HTMLElement).style.opacity = atEnd ? '0.4' : '1';
      }
    }

    if (prevBtn) {
      prevBtn.onclick = () => {
        if (!track) return;
        const visible = getVisibleCards();
        const cardWidth = visible.length > 0 ? (visible[0] as HTMLElement).offsetWidth + 24 : 400;
        track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
      };
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        if (!track) return;
        const visible = getVisibleCards();
        const cardWidth = visible.length > 0 ? (visible[0] as HTMLElement).offsetWidth + 24 : 400;
        track.scrollBy({ left: cardWidth, behavior: 'smooth' });
      };
    }

    if (track) {
      track.addEventListener('scroll', updateCarouselIndicators, { passive: true });
    }

    function pauseAllInlineVideos(exceptId?: string) {
      cards.forEach((card) => {
        const id = card.getAttribute('data-reel-id');
        if (id && id !== exceptId) {
          const video = document.getElementById(`video-${id}`) as HTMLVideoElement | null;
          const videoBox = document.getElementById(`video-box-${id}`);
          const toggleBtn = document.getElementById(`inline-toggle-${id}`);

          if (video && !video.paused) {
            video.pause();
          }
          if (videoBox) {
            videoBox.classList.remove('is-playing');
          }
          if (toggleBtn) {
            const sym = toggleBtn.querySelector('.control-symbol');
            if (sym) sym.textContent = 'play_arrow';
          }
        }
      });
    }

    async function openTheaterModal(reelId: string) {
      const reel = reelsData.find((r) => r.id === reelId);
      if (!reel || !modal || !modalVideo) return;

      pauseAllInlineVideos();

      if (modalTitle) modalTitle.textContent = reel.title;
      if (modalLocation) modalLocation.textContent = reel.location;
      if (modalCategoryChip) {
        modalCategoryChip.textContent = reel.category === 'ongoing' ? 'ON-SITE SITE' : 'HANDED OVER';
        modalCategoryChip.className = `modal-category-chip font-mono-data ${reel.category}`;
      }
      if (modalStageHeadline) modalStageHeadline.textContent = reel.stage;
      if (modalDescText) modalDescText.textContent = reel.description;

      if (modalSpecsList) {
        modalSpecsList.innerHTML = (reel.specs || [])
          .map(
            (s) => `
          <div class="modal-spec-item font-mono-data">
            <span class="m-spec-label">${escapeHtml(s.label)}</span>
            <span class="m-spec-val">${escapeHtml(s.value)}</span>
          </div>
        `
          )
          .join('');
      }

      const resolvedVideo = await resolveMediaUrl(reel.videoSrc);
      const resolvedPoster = await resolveMediaUrl(reel.poster);

      modalVideo.src = resolvedVideo;
      modalVideo.poster = resolvedPoster;
      modalVideo.currentTime = 0;
      modalVideo.muted = false;

      if (modalVolumeIcon) {
        modalVolumeIcon.textContent = 'volume_up';
      }

      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';

      modalVideo.play().then(() => {
        if (modalPlayIcon) modalPlayIcon.textContent = 'pause';
      }).catch(() => {
        if (modalPlayIcon) modalPlayIcon.textContent = 'play_arrow';
      });
    }

    function closeTheaterModal() {
      if (!modal) return;
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      if (modalVideo) {
        modalVideo.pause();
        modalVideo.src = '';
      }
    }

    if (modalCloseBtn) modalCloseBtn.onclick = closeTheaterModal;
    if (modalBackdrop) modalBackdrop.onclick = closeTheaterModal;

    if (modalPlayBtn && modalVideo) {
      modalPlayBtn.onclick = () => {
        if (modalVideo.paused) {
          modalVideo.play();
          if (modalPlayIcon) modalPlayIcon.textContent = 'pause';
        } else {
          modalVideo.pause();
          if (modalPlayIcon) modalPlayIcon.textContent = 'play_arrow';
        }
      };
    }

    if (modalVolumeBtn && modalVideo) {
      modalVolumeBtn.onclick = () => {
        modalVideo.muted = !modalVideo.muted;
        if (modalVolumeIcon) {
          modalVolumeIcon.textContent = modalVideo.muted ? 'volume_off' : 'volume_up';
        }
      };
    }

    if (modalVideo) {
      modalVideo.ontimeupdate = () => {
        if (modalProgressFill && modalVideo.duration) {
          const pct = (modalVideo.currentTime / modalVideo.duration) * 100;
          modalProgressFill.style.width = `${pct}%`;
        }
        if (modalTimeDisplay && modalVideo.duration) {
          const curM = Math.floor(modalVideo.currentTime / 60);
          const curS = Math.floor(modalVideo.currentTime % 60);
          const durM = Math.floor(modalVideo.duration / 60);
          const durS = Math.floor(modalVideo.duration % 60);
          modalTimeDisplay.textContent = `${curM}:${curS < 10 ? '0' : ''}${curS} / ${durM}:${durS < 10 ? '0' : ''}${durS}`;
        }
      };
      modalVideo.onended = () => {
        if (modalPlayIcon) modalPlayIcon.textContent = 'play_arrow';
      };
    }

    if (modalProgressBar && modalVideo) {
      modalProgressBar.onclick = (e) => {
        const rect = modalProgressBar.getBoundingClientRect();
        const pos = (e.clientX - rect.left) / rect.width;
        if (modalVideo.duration) {
          modalVideo.currentTime = pos * modalVideo.duration;
        }
      };
    }

    if (modalFullscreenBtn && modalVideo) {
      modalFullscreenBtn.onclick = () => {
        if (!document.fullscreenElement) {
          modalVideo.requestFullscreen().catch(() => {});
        } else {
          document.exitFullscreen().catch(() => {});
        }
      };
    }

    if (modalInquireCta) {
      modalInquireCta.onclick = closeTheaterModal;
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('open')) {
        closeTheaterModal();
      }
    });

    function bindCardListeners() {
      cards.forEach((card) => {
        const reelId = card.getAttribute('data-reel-id');
        if (!reelId) return;

        const videoBox = document.getElementById(`video-box-${reelId}`);
        const video = document.getElementById(`video-${reelId}`) as HTMLVideoElement | null;
        const playTrigger = document.getElementById(`play-btn-${reelId}`);
        const toggleBtn = document.getElementById(`inline-toggle-${reelId}`);
        const muteBtn = document.getElementById(`inline-mute-${reelId}`);
        const progressFill = document.getElementById(`progress-${reelId}`);
        const theaterBtns = card.querySelectorAll('[data-theater-id]');

        if (!video) return;

        function startInlinePlayback() {
          pauseAllInlineVideos(reelId);
          if (videoBox) videoBox.classList.add('is-playing');
          if (toggleBtn) {
            const sym = toggleBtn.querySelector('.control-symbol');
            if (sym) sym.textContent = 'pause';
          }
          video.play().catch(() => {
            if (videoBox) videoBox.classList.remove('is-playing');
          });
        }

        function toggleInlinePlayback() {
          if (video.paused) {
            startInlinePlayback();
          } else {
            video.pause();
            if (toggleBtn) {
              const sym = toggleBtn.querySelector('.control-symbol');
              if (sym) sym.textContent = 'play_arrow';
            }
          }
        }

        if (playTrigger) {
          playTrigger.onclick = (e) => {
            e.stopPropagation();
            startInlinePlayback();
          };
        }

        if (toggleBtn) {
          toggleBtn.onclick = (e) => {
            e.stopPropagation();
            toggleInlinePlayback();
          };
        }

        if (muteBtn) {
          muteBtn.onclick = (e) => {
            e.stopPropagation();
            video.muted = !video.muted;
            const sym = muteBtn.querySelector('.control-symbol');
            if (sym) {
              sym.textContent = video.muted ? 'volume_off' : 'volume_up';
            }
          };
        }

        video.ontimeupdate = () => {
          if (progressFill && video.duration) {
            const pct = (video.currentTime / video.duration) * 100;
            progressFill.style.width = `${pct}%`;
          }
        };

        video.onended = () => {
          if (toggleBtn) {
            const sym = toggleBtn.querySelector('.control-symbol');
            if (sym) sym.textContent = 'play_arrow';
          }
          if (videoBox) videoBox.classList.remove('is-playing');
        };

        theaterBtns.forEach((btn) => {
          (btn as HTMLElement).onclick = (e) => {
            e.stopPropagation();
            openTheaterModal(reelId);
          };
        });
      });
    }

    async function renderReels(items: SiteReel[]) {
      if (!track) return;
      reelsData = items;
      (window as any).__AFRAH_REELS_DATA = items;

      pauseAllInlineVideos();

      const resolvedItems = await Promise.all(
        items.map(async (r, index) => {
          const videoSrc = await resolveMediaUrl(r.videoSrc);
          const poster = await resolveMediaUrl(r.poster);
          return { ...r, videoSrc, poster, index };
        })
      );

      track.innerHTML = resolvedItems
        .map(
          (reel) => `
        <article
          class="reel-item"
          data-category="${reel.category}"
          data-reel-id="${reel.id}"
          data-index="${reel.index}"
          data-animate="fade-up"
          style="--stagger: ${((reel.index % 3) + 1) * 100}ms;"
        >
          <div class="reel-video-container" id="video-box-${reel.id}">
            <video
              class="reel-video-element"
              id="video-${reel.id}"
              poster="${reel.poster}"
              preload="metadata"
              playsinline
              muted
              loop
            >
              <source src="${reel.videoSrc}" type="${reel.videoSrc.endsWith('.webm') ? 'video/webm' : 'video/mp4'}" />
              Your browser does not support HTML5 video playback.
            </video>

            <div class="video-poster-overlay" id="poster-overlay-${reel.id}">
              <img
                src="${reel.poster}"
                alt="${escapeHtml(reel.title)} - ${escapeHtml(reel.subtitle)}"
                class="poster-fallback-img"
                loading="lazy"
              />
              <div class="poster-gradient-shade"></div>

              <div class="poster-top-bar">
                <span class="stage-tag font-mono-data">${escapeHtml(reel.stage)}</span>
                <span class="category-tag font-mono-data ${reel.category}">
                  <span class="status-dot"></span>
                  ${reel.category === 'ongoing' ? 'ON-SITE' : 'FINISHED'}
                </span>
              </div>

              <button
                class="central-play-trigger"
                id="play-btn-${reel.id}"
                aria-label="Play video: ${escapeHtml(reel.title)}"
                data-reel-id="${reel.id}"
              >
                <div class="play-pulse-ring"></div>
                <div class="play-icon-disc">
                  <span class="material-symbols-outlined play-arrow-icon">play_arrow</span>
                </div>
              </button>

              <div class="poster-bottom-meta">
                <span class="duration-chip font-mono-data">
                  <span class="material-symbols-outlined" style="font-size: 13px;">schedule</span>
                  ${escapeHtml(reel.duration)}
                </span>
                <button
                  class="overlay-expand-btn"
                  data-theater-id="${reel.id}"
                  aria-label="Fullscreen Theater View"
                  title="Fullscreen Theater View"
                >
                  <span class="material-symbols-outlined" style="font-size: 16px;">open_in_full</span>
                </button>
              </div>
            </div>

            <div class="inline-video-controls" id="controls-${reel.id}">
              <div class="controls-left">
                <button
                  class="control-icon-btn inline-play-pause-btn"
                  id="inline-toggle-${reel.id}"
                  aria-label="Pause video"
                  data-reel-id="${reel.id}"
                >
                  <span class="material-symbols-outlined control-symbol">pause</span>
                </button>
                <button
                  class="control-icon-btn inline-mute-btn"
                  id="inline-mute-${reel.id}"
                  aria-label="Toggle audio"
                  data-reel-id="${reel.id}"
                >
                  <span class="material-symbols-outlined control-symbol">volume_off</span>
                </button>
              </div>

              <div class="inline-progress-track">
                <div class="inline-progress-fill" id="progress-${reel.id}"></div>
              </div>

              <div class="controls-right">
                <button
                  class="control-icon-btn theater-expand-btn"
                  aria-label="Open in Cinematic Theater Mode"
                  data-theater-id="${reel.id}"
                  title="Expand to Fullscreen Theater View"
                >
                  <span class="material-symbols-outlined control-symbol">open_in_full</span>
                </button>
              </div>
            </div>
          </div>

          <div class="reel-item-info">
            <div class="reel-item-meta">
              <h4 class="font-headline-md reel-title">${escapeHtml(reel.title)}</h4>
              <p class="font-body-sm reel-subtitle">${escapeHtml(reel.subtitle)}</p>
            </div>
            <div class="reel-item-data">
              <span class="reel-location-pill font-mono-data">${escapeHtml(reel.location)}</span>
              <button
                class="reel-theater-btn font-mono-data"
                data-theater-id="${reel.id}"
                title="View full project specifications"
              >
                <span>SPECS</span>
                <span class="material-symbols-outlined" style="font-size: 13px;">arrow_outward</span>
              </button>
            </div>
          </div>
        </article>
      `
        )
        .join('');

      cards = Array.from(document.querySelectorAll('.reel-item'));

      filterTabs.forEach((tab) => {
        const key = tab.getAttribute('data-filter');
        const countSpan = tab.querySelector('.tab-count');
        if (countSpan) {
          const count =
            key === 'all'
              ? items.length
              : items.filter((r) => r.category === key).length;
          countSpan.textContent = String(count);
        }
      });

      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const isMatch = activeFilter === 'all' || category === activeFilter;
        card.style.display = isMatch ? 'flex' : 'none';
      });

      if (totalIndicator) {
        totalIndicator.textContent = items.length < 10 ? `0${items.length}` : `${items.length}`;
      }

      bindCardListeners();
      updateCarouselIndicators();
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        activeFilter = tab.getAttribute('data-filter') || 'all';
        pauseAllInlineVideos();

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          const isMatch = activeFilter === 'all' || category === activeFilter;
          card.style.display = isMatch ? 'flex' : 'none';
        });

        if (track) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        }
        setTimeout(updateCarouselIndicators, 150);
      });
    });

    // 1. Initial render with stored / live reels
    const initialLiveReels = getStoredReels();
    renderReels(initialLiveReels);

    // 2. Subscribe to live updates from the app
    subscribeToReelsUpdates((updatedReels) => {
      renderReels(updatedReels);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSiteCinematics);
  } else {
    initSiteCinematics();
  }
</script>

